<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2026.11.9</Version>

    <PluginInternalName>SendGameStatusPlugin</PluginInternalName>
    <PluginDisplayName>向AI发送游戏信息</PluginDisplayName>
    <PluginAuthor>UmaAi Team</PluginAuthor>
    <PluginDescription>如果AI程序没打开就没任何作用</PluginDescription>
    <PluginChangelog>修复骏大祭 trainLevelTotal 被稽古项覆盖导致的等级跳变（3→1→3）：稽古 5101–5105 的 level 恒为 1、不是训练位等级，改为只取基础训练项、load/command 帧建基准并用最近观测值补齐合宿与稽古段，事件/结算帧整组置 0；剧本结算帧（playing_state 49/51 等）标为 special 而非 command；骏大祭：助力支撑按状态 47 输出 0/1，仅表示有无、不维护剩余次数；festa 段去掉与 baseGame 重复的人员分布，persons 只保留人物 id、来源与演目归属；NPC 人头写协议原始 id、persons 补真实 charaId；festa.persons 的 targetId 换算到与 personDistribution 同一编号空间并只发有演目归属的成员。通用段新增 training：按指令 ID 给出下层/上层 7 项训练数值与失败率，供 AI 端比对自身计算；新增骏大祭（剧本 15）状态发送：演目、教诲/转成、発表会、追加稽古与担当名单；训练等级改用历史点击数；新增拉面杯状态发送；修复响应来源、缺少主页数据时的处理和未试吃状态值；按育成 ID、回合及序号保存输出；同步可选插件依赖；更新 EventLoggerPlugin 与 RamenScenarioAnalyzer 源码依赖。</PluginChangelog>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/SendGameStatusPlugin</PluginRepositoryUrl>
    <PluginDependencies>EventLoggerPlugin,RamenScenarioAnalyzer,FestaScenarioAnalyzer</PluginDependencies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="deps\EventLoggerPlugin\EventLoggerPlugin.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="deps\RamenScenarioAnalyzer\RamenScenarioAnalyzer.csproj">
      <Private>False</Private>
    </ProjectReference>
    <ProjectReference Include="deps\FestaScenarioAnalyzer\FestaScenarioAnalyzer.csproj">
      <Private>False</Private>
    </ProjectReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="i18n\Cook.Designer.cs">
      <DependentUpon>Cook.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="i18n\Cook.zh-CN.Designer.cs">
      <DependentUpon>Cook.zh-CN.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="i18n\Game.Designer.cs">
      <DependentUpon>Game.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="i18n\Cook.resx">
      <LastGenOutput>Cook.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\Cook.zh-CN.resx">
      <LastGenOutput>Cook.zh-CN.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\Game.resx">
      <LastGenOutput>Game.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="*" PrivateAssets="all" />
  </ItemGroup>

</Project>
