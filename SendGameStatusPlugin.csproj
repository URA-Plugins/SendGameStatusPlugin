<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>

    <PluginInternalName>SendGameStatusPlugin</PluginInternalName>
    <PluginDisplayName>向AI发送游戏信息</PluginDisplayName>
    <PluginAuthor>UmaAi Team</PluginAuthor>
    <PluginDescription>如果AI程序没打开就没任何作用</PluginDescription>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/SendGameStatusPlugin</PluginRepositoryUrl>
    <PluginDependencies>EventLoggerPlugin</PluginDependencies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="deps\EventLoggerPlugin\EventLoggerPlugin.csproj">
      <Private>False</Private>
    </ProjectReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="i18n\Cook.Designer.cs">
      <DependentUpon>Cook.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="i18n\Cook.zh-CN.Designer.cs">
      <DependentUpon>Cook.zh-CN.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="i18n\Game.Designer.cs">
      <DependentUpon>Game.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="i18n\Cook.resx">
      <LastGenOutput>Cook.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\Cook.zh-CN.resx">
      <LastGenOutput>Cook.zh-CN.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\Game.resx">
      <LastGenOutput>Game.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="2026.9.1" />
  </ItemGroup>

</Project>
