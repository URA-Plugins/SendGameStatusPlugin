<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsUraPlugin>false</IsUraPlugin>
    <GenerateUraPluginManifestOnBuild>false</GenerateUraPluginManifestOnBuild>
    <PackageUraPluginOnBuild>false</PackageUraPluginOnBuild>
    <DeployUraPluginToLocalAppDataOnBuild>false</DeployUraPluginToLocalAppDataOnBuild>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <UseSharedCompilation>false</UseSharedCompilation>
    <_SmokeProjectReferenceProperties>GenerateUraPluginManifestOnBuild=false;PackageUraPluginOnBuild=false;DeployUraPluginToLocalAppDataOnBuild=false;DisableTransitiveProjectReferences=true;UseSharedCompilation=false</_SmokeProjectReferenceProperties>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UraTestHostRoot)\eng\PluginTesting\SmokeHost.cs" Link="WorkspaceSmokeSession.cs" />
    <ProjectReference
      Include="$(UraTestHostRoot)\UmamusumeResponseAnalyzer\UmamusumeResponseAnalyzer.csproj"
      AdditionalProperties="$(_SmokeProjectReferenceProperties)" />
    <ProjectReference
      Include="..\..\deps\EventLoggerPlugin\EventLoggerPlugin.csproj"
      AdditionalProperties="$(_SmokeProjectReferenceProperties)" />
    <ProjectReference
      Include="..\..\deps\RamenScenarioAnalyzer\RamenScenarioAnalyzer.csproj"
      AdditionalProperties="$(_SmokeProjectReferenceProperties)" />
    <ProjectReference
      Include="..\..\SendGameStatusPlugin.csproj"
      AdditionalProperties="$(_SmokeProjectReferenceProperties)" />
  </ItemGroup>

</Project>
